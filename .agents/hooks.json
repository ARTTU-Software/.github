{
  "arttu-guardrails": {
    "PreToolUse": [
      {
        "matcher": "view_file|replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/pre_tool_enforcer.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
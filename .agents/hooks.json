{
  "arttu-guardrails": {
    "PreToolUse": [
      {
        "matcher": "view_file|replace_file_content|write_to_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os,sys,subprocess; s='hooks/pre_tool_enforcer.py' if os.path.exists('hooks/pre_tool_enforcer.py') else '.agents/hooks/pre_tool_enforcer.py'; sys.exit(subprocess.run([sys.executable,s]).returncode)\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
